{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "hooks-everywhere self-heal" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "hooks-everywhere check-restart" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "hooks-everywhere guard" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "hooks-everywhere audit" }
        ]
      }
    ]
  }
}
